{
  "name": "telegram-monitor",
  "version": "1.0.0",
  "description": "Production-grade Telegram channel monitoring system with real-time WebSocket and webhook support",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "login": "tsx scripts/telegram-login.ts",
    "logout": "tsx scripts/telegram-logout.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t telegram-monitor .",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "security:audit": "npm audit --omit=dev",
    "security:scan": "trivy fs --severity HIGH,CRITICAL .",
    "ci": "npm run lint && npm run test && npm run typecheck"
  },
  "keywords": ["telegram", "monitoring", "realtime", "websocket", "webhook"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "dependencies": {
    "express": "4.21.2",
    "ws": "8.17.3",
    "@telegram.ts/router": "^0.2.0",
    "pg": "8.14.0",
    "bcrypt": "5.1.1",
    "argon2": "0.40.4",
    "pino": "9.6.0",
    "pino-http": "9.0.1",
    "cors": "2.8.5",
    "helmet": "8.0.2",
    "jose": "5.4.7",
    "ioredis": "5.5.0",
    "zod": "3.22.4",
    "zod-validation-error": "3.4.0",
    "p-queue": "7.4.1",
    "bullmq": "5.9.3",
    "sharp": "0.33.5",
    "latest": "1.0.1",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "typescript": "5.7.0",
    "tsx": "4.17.0",
    "eslint": "9.16.0",
    "prettier": "3.2.5",
    "vitest": "2.1.8",
    "@types/node": "22.0.0",
    "@types/bcrypt": "5.0.2",
    "@types/pg": "8.11.11",
    "@types/cors": "2.8.17",
    "@types/helmet": "4.0.0",
    "@types/ioredis": "5.4.1",
    "@types/ws": "8.5.10",
    "@types/express": "4.18.3",
    "@vitest/coverage-v8": "2.1.8",
    "@types/bullmq": "5.40.1",
    "@types/sharp": "0.32.6",
    "@types/compression": "1.7.4",
    "@types/morgan": "1.9.0",
    "c8": "10.1.2",
    "eslint-config-prettier": "9.2.0",
    "eslint-plugin-prettier": "5.2.1",
    "type-coverage": "2.29.1"
  },
  "overrides": {
    "nock": "^13.5.4"
  }
}