{
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "plugins": ["prettier"],
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "rules": {
    "prettier/prettier": "error",
    "no-unused-vars": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "curly": "error",
    "prefer-arrow-callback": "error",
    "no-console": ["warn", { "allow": ["error", "warn"] }]
  }
}