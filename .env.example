# Environment Configuration for Telegram Monitor

# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_monitor
DATABASE_POOL_SIZE=20
SQLITE_PATH=./dev.db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Telegram Session
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
PHONE_NUMBER=+1234567890
SESSION_ENC_KEY=base64_encoded_32_byte_key_here
CHANNEL_USERNAME=airdropfind
MEDIA_DOWNLOAD_DIR=./media
MAX_MEDIA_SIZE_MB=100
MEDIA_MIME_WHITELIST=image/jpeg,image/png,image/gif,application/pdf,video/mp4,video/quicktime,audio/mpeg,audio/wav

# JWT
JWT_SECRET=base64_encoded_32_byte_jwt_secret
JWT_ISSUER=telegram-monitor
JWT_AUDIENCE=api-client
JWT_EXPIRES_IN=15m

# API Key Management
API_KEY_PREFIX=tm_
API_KEY_HASH_ROUNDS=4
API_KEY_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_KEY=100
WEBHOOK_TIMEOUT=30000

# WebSocket
WS_MAX_PAYLOAD=16384
WS_HEARTBEAT_INTERVAL=30000
WS_IDLE_TIMEOUT=300000
WS_MAX_CONNECTIONS_PER_IP=100
WS_MAX_CONNECTIONS_PER_KEY=100

# Webhook Outbound
WEBHOOK_MAX_RETRIES=8
WEBHOOK_RETRY_DELAY_BASE=1000
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_SIZE=1000000
WEBHOOK_CACHE_TTL=3600

# Security
ALLOWED_ORIGINS=https://example.com,https://app.example.com
ALLOWED_IP_RANGES=203.0.113.0/24,198.51.100.0/24
BLOCKED_IP_RANGES=127.0.0.0/8,10.0.0.0/8,172.16.0.0/16,192.168.0.0/16,169.254.0.0/16,::1,fc00::/7
CORS_MAX_AGE=600
CORS_EXPOSED_HEADERS=x-request-id,x-total-count

# Logging
LOG_LEVEL=info
LOG_REDACTION_PATTERNS=authorization,api_key,session,phone,otp,secret
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_AUTH_TOKEN=

# SSL/TLS
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
SSL_CIPHERS=TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256
SSL_MIN_VERSION=TLS1.2

# Operational
SHUTDOWN_TIMEOUT=30000
HEARTBEAT_TIMEOUT_MS=300000
RECONNECT_BACKOFF_MAX_MS=60000
BACKFILL_MESSAGES_N=100
MAX_MESSAGE_EDIT_REVISIONS=10

# HTTPS Proxy for outbound webhooks
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.local

# Audit Log
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_LOG_RETENTION_DAYS=90

# ClamAV (optional)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10000

# Monitoring and Alerting
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# CI/CD
GITHUB_ACTIONS_RUNNER=

# Docker
DOCKER=true
RUN_USER=telegram

# Test
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_monitor_test
TEST_REDIS_URL=redis://localhost:6379
TEST_PHONE_NUMBER=+1234567890
TEST_API_ID=12345
TEST_API_HASH=abcdef1234567890